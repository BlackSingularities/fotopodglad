<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.Background">#F4F4F7</Color>
    <Color x:Key="Color.SurfaceOverlay">#E8FFFFFF</Color>
    <Color x:Key="Color.TextPrimary">#18181C</Color>
    <Color x:Key="Color.TextSecondary">#5E5E68</Color>
    <Color x:Key="Color.Accent">#B87912</Color>
    <Color x:Key="Color.GridPlaceholder">#E4E4E9</Color>
    <Color x:Key="Color.Card">#FFFFFF</Color>
    <Color x:Key="Color.Control">#F0F0F4</Color>
    <Color x:Key="Color.Border">#D0D0D8</Color>

    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}"/>
    <SolidColorBrush x:Key="Brush.SurfaceOverlay" Color="{StaticResource Color.SurfaceOverlay}"/>
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/>
    <SolidColorBrush x:Key="Brush.GridPlaceholder" Color="{StaticResource Color.GridPlaceholder}"/>
    <SolidColorBrush x:Key="Brush.Card" Color="{StaticResource Color.Card}"/>
    <SolidColorBrush x:Key="Brush.Control" Color="{StaticResource Color.Control}"/>
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}"/>
</ResourceDictionary>
