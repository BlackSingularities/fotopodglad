<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Zestaw ikon EXIF jako czyste wektorowe ścieżki (WPF Geometry, składnia zgodna z SVG path data).
        Celowo NIE używamy fontów ikon ani emoji — renderują się identycznie na każdej maszynie,
        niezależnie od zainstalowanych fontów, i skalują się bezstratnie. Styl: proste ikony liniowe
        (24x24 viewbox), rysowane przez Stroke, żeby zachować spójną, lekką stylistykę w ExifBadge.
    -->

    <Geometry x:Key="Icon.FileName">
        M6,2 L14,2 L18,6 L18,22 L6,22 Z M14,2 L14,6 L18,6 M8.5,13 L15.5,13 M8.5,17 L13,17
    </Geometry>

    <Geometry x:Key="Icon.Clock">
        M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z M12,7 L12,12 L16,14
    </Geometry>

    <Geometry x:Key="Icon.Aperture">
        M2,12 A10,10 0 1 1 22,12 A10,10 0 1 1 2,12 Z M12,6 L17,9 L17,15 L12,18 L7,15 L7,9 Z
    </Geometry>

    <Geometry x:Key="Icon.ShutterSpeed">
        M9,2 L15,2 M12,4 A9,9 0 1 0 12.01,4 Z M12,8 L12,13 L15,15
    </Geometry>

    <Geometry x:Key="Icon.Iso">
        M12,12 m-4,0 a4,4 0 1 0 8,0 a4,4 0 1 0 -8,0
        M12,2 L12,5 M12,19 L12,22 M2,12 L5,12 M19,12 L22,12
        M4.9,4.9 L7,7 M17,17 L19.1,19.1 M4.9,19.1 L7,17 M17,7 L19.1,4.9
    </Geometry>

    <Geometry x:Key="Icon.FocalLength">
        M12,12 m-9,0 a9,9 0 1 0 18,0 a9,9 0 1 0 -18,0
        M12,12 m-4,0 a4,4 0 1 0 8,0 a4,4 0 1 0 -8,0
        M12,12 m-1.2,0 a1.2,1.2 0 1 0 2.4,0 a1.2,1.2 0 1 0 -2.4,0
    </Geometry>

    <Geometry x:Key="Icon.ExposureProgram">
        M4,8 L8,8 L9.5,5.5 L14.5,5.5 L16,8 L20,8 L20,19 L4,19 Z
        M12,9 m-4,0 a4,4 0 1 0 8,0 a4,4 0 1 0 -8,0
    </Geometry>

    <Geometry x:Key="Icon.Resolution">
        M3,3 L21,3 L21,21 L3,21 Z
        M8,16 L3,21 M3,16 L3,21 L8,21
        M16,8 L21,3 M21,8 L21,3 L16,3
    </Geometry>

    <Geometry x:Key="Icon.FileSize">
        M4,6 A8,3 0 0 0 20,6 A8,3 0 0 0 4,6 Z
        M4,6 L4,18 A8,3 0 0 0 20,18 L20,6
        M4,12 A8,3 0 0 0 20,12
    </Geometry>

    <Geometry x:Key="Icon.ZoomIn">
        M2,12 A9,9 0 1 1 20,12 A9,9 0 1 1 2,12 Z M11,7 L11,15 M7,11 L15,11 M18,18 L23,23
    </Geometry>

</ResourceDictionary>
