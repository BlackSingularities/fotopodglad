<Window x:Class="Fotopodglad.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fotopodgląd — ustawienia" Width="820" Height="860" MinWidth="720" MinHeight="680"
        WindowStartupLocation="CenterScreen" ShowActivated="True" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource Brush.Background}" Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{StaticResource Font.Primary}">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="AboutBody" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/><Setter Property="LineHeight" Value="20"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/><Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Card}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="36"/><Setter Property="Padding" Value="10,7"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Control}"/><Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="36"/><Setter Property="Padding" Value="10,7"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Control}"/><Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="36"/><Setter Property="Padding" Value="8,6"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Control}"/><Setter Property="Foreground" Value="#151515"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="18,9"/><Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Foreground" Value="#151515"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource Brush.Control}"/><Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="26,22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="2,0,2,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="AppNameTextBlock" Text="Fotopodgląd" FontSize="25" FontWeight="SemiBold"/>
                <TextBlock x:Name="SettingsSubtitleTextBlock" Text="Konfiguracja prezentacji, galerii i udostępniania" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
            <Image Grid.Column="1" Width="48" Height="48" Source="/Assets/Icons/Fotopodglad-128.png"/>
        </Grid>

        <TabControl x:Name="SettingsTabs" Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem x:Name="GeneralTab" Header="Ustawienia">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,8,0">
                    <StackPanel>
                        <Border Style="{StaticResource SectionCard}"><StackPanel>
                            <TextBlock Text="Ekrany i okna" Style="{StaticResource SectionTitle}"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Tryb widoków" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="WindowModeComboBox"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Układ monitorów" Style="{StaticResource FieldLabel}"/>
                                    <Border Height="96" Background="{DynamicResource Brush.Control}" CornerRadius="8" Padding="6"><Canvas x:Name="ScreenPreviewCanvas"/></Border>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Okno A — podgląd" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="MainViewScreenComboBox"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Okno B — siatka" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="GridScreenComboBox"/></StackPanel>
                            </Grid>
                            <TextBlock Text="F11 przełącza tryb pełnoekranowy i okienkowy. Pozycje okien są zapamiętywane." Style="{StaticResource HintText}" Margin="0,10,0,0"/>
                        </StackPanel></Border>

                        <Border Style="{StaticResource SectionCard}"><StackPanel>
                            <TextBlock Text="Folder zdjęć" Style="{StaticResource SectionTitle}"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="WatchedFolderTextBox"/><Button Grid.Column="1" Content="Wybierz…" Click="OnBrowseFolderClick" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"/>
                            </Grid>
                            <TextBlock Text="Po utracie dysku aplikacja pokaże ostrzeżenie i automatycznie wznowi obserwowanie po jego powrocie." Style="{StaticResource HintText}" Margin="0,8,0,0"/>
                        </StackPanel></Border>

                        <Border Style="{StaticResource SectionCard}"><StackPanel>
                            <TextBlock Text="Galeria i podgląd" Style="{StaticResource SectionTitle}"/>
                            <CheckBox x:Name="ShowPhotoParametersCheckBox" Content="Pokazuj nazwę i parametry EXIF" Margin="0,0,0,10"/>
                            <CheckBox x:Name="ShowClippingWarningsCheckBox" Content="Oznaczaj przepalenia na czerwono i niedoświetlenia na niebiesko" Margin="0,0,0,14"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Kolumny siatki" Style="{StaticResource FieldLabel}"/><TextBox x:Name="GridColumnsTextBox"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Czas podglądu (s)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ManualHoldTextBox"/></StackPanel>
                                <StackPanel Grid.Column="4"><TextBlock Text="Histogram" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="HistogramComboBox"/></StackPanel>
                            </Grid>
                            <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Filtr zdjęć" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="PhotoFilterComboBox"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Data od" Style="{StaticResource FieldLabel}"/><DatePicker x:Name="FilterFromDatePicker"/></StackPanel>
                                <StackPanel Grid.Column="4"><TextBlock Text="Data do" Style="{StaticResource FieldLabel}"/><DatePicker x:Name="FilterToDatePicker"/></StackPanel>
                            </Grid>
                            <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Limit cache miniaturek (MB)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ThumbnailCacheTextBox"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Rozmiar tekstu EXIF" Style="{StaticResource FieldLabel}"/><Slider x:Name="ExifTextSizeSlider" Minimum="10" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True"/></StackPanel>
                            </Grid>
                            <TextBlock Text="Prawy przycisk myszy na miniaturze oznacza lub odznacza zdjęcie." Style="{StaticResource HintText}" Margin="0,10,0,0"/>
                        </StackPanel></Border>

                        <Border Style="{StaticResource SectionCard}"><StackPanel>
                            <TextBlock Text="Hotspot i pobieranie" Style="{StaticResource SectionTitle}"/>
                            <CheckBox x:Name="GuestAccessEnabledCheckBox" Content="Automatycznie uruchamiaj hotspot i QR" Margin="0,0,0,8"/>
                            <CheckBox x:Name="ShowGuestInstructionsCheckBox" Content="Pokazuj instrukcję pod siatką" Margin="0,0,0,14"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Nazwa Wi‑Fi (puste = losowa)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="WifiSsidTextBox"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Hasło (puste = losowe)" Style="{StaticResource FieldLabel}"/><PasswordBox x:Name="WifiPasswordBox"/></StackPanel>
                            </Grid>
                            <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Wielkość QR" Style="{StaticResource FieldLabel}"/><Slider x:Name="QrSizeSlider" Minimum="96" Maximum="320" TickFrequency="16" IsSnapToTickEnabled="True" ValueChanged="OnQrSizeChanged"/><TextBlock x:Name="QrSizeValueTextBlock" Style="{StaticResource HintText}"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Jednoczesne pobrania (1–20)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="MaxDownloadsTextBox"/><TextBlock Text="Oryginalny plik jest wysyłany bez rekompresji i utraty jakości." Style="{StaticResource HintText}" Margin="0,6,0,0"/></StackPanel>
                            </Grid>
                            <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Rozmiar instrukcji" Style="{StaticResource FieldLabel}"/><Slider x:Name="InstructionTextSizeSlider" Minimum="9" Maximum="28" TickFrequency="1" IsSnapToTickEnabled="True"/></StackPanel>
                                <CheckBox Grid.Column="2" x:Name="CheckForUpdatesCheckBox" Content="Automatycznie sprawdzaj aktualizacje GitHub" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel></Border>

                        <Border Style="{StaticResource SectionCard}"><StackPanel>
                            <TextBlock Text="Wygląd i język" Style="{StaticResource SectionTitle}"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Motyw" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ThemeComboBox"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Skala interfejsu" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="UiScaleComboBox"/></StackPanel>
                                <StackPanel Grid.Column="4"><TextBlock Text="Język" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="LanguageComboBox"/></StackPanel>
                            </Grid>
                        </StackPanel></Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="DiagnosticsTab" Header="Diagnostyka">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,8,0"><StackPanel>
                    <Border Style="{StaticResource SectionCard}"><StackPanel>
                        <TextBlock Text="Hotspot" Style="{StaticResource SectionTitle}"/>
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Stan" Style="{StaticResource FieldLabel}"/><TextBlock Grid.Column="1" x:Name="DiagnosticStatusTextBlock" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="1" Text="Adres IP" Style="{StaticResource FieldLabel}"/><TextBlock Grid.Row="1" Grid.Column="1" x:Name="DiagnosticIpTextBlock"/>
                            <TextBlock Grid.Row="2" Text="Próba naprawy" Style="{StaticResource FieldLabel}"/><TextBlock Grid.Row="2" Grid.Column="1" x:Name="DiagnosticRetryTextBlock"/>
                            <TextBlock Grid.Row="3" Text="Aktywne pobrania" Style="{StaticResource FieldLabel}"/><TextBlock Grid.Row="3" Grid.Column="1" x:Name="DiagnosticDownloadsTextBlock"/>
                            <TextBlock Grid.Row="4" Text="Ostatnia zmiana" Style="{StaticResource FieldLabel}"/><TextBlock Grid.Row="4" Grid.Column="1" x:Name="DiagnosticTransitionTextBlock"/>
                        </Grid>
                        <Border x:Name="DiagnosticErrorBorder" Margin="0,14,0,0" Padding="12" Background="#35D94A4A" CornerRadius="7">
                            <TextBlock x:Name="DiagnosticErrorTextBlock" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel></Border>
                    <Border Style="{StaticResource SectionCard}"><StackPanel>
                        <TextBlock Text="Folder" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="DiagnosticFolderTextBlock" TextWrapping="Wrap"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource SectionCard}"><StackPanel>
                        <TextBlock Text="Aktualizacje" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="UpdateStatusTextBlock" Text="Nie sprawdzano w tej sesji." Style="{StaticResource HintText}" Margin="0,0,0,10"/>
                        <Button Content="Sprawdź teraz" HorizontalAlignment="Left" Click="OnCheckUpdatesClick"/>
                    </StackPanel></Border>
                </StackPanel></ScrollViewer>
            </TabItem>

            <TabItem x:Name="AboutTab" Header="O aplikacji">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,14,8,0"><StackPanel>
                    <Border Style="{StaticResource SectionCard}"><StackPanel>
                        <TextBlock x:Name="AboutAppNameTextBlock" Text="Fotopodgląd" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="Podgląd, selekcja i bezstratne udostępnianie zdjęć podczas sesji." Style="{StaticResource AboutBody}" Margin="0,8,0,0"/>
                        <TextBlock Text="Obsługiwane są JPEG, PNG, TIFF, HEIC/HEIF oraz popularne formaty RAW: ARW, NEF/NRW, CR2/CR3, RAF, DNG, RW2, ORF i PEF. Dostępność konkretnego kodeka zależy od pliku i systemu." Style="{StaticResource AboutBody}" Margin="0,8,0,0"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource SectionCard}"><StackPanel>
                        <TextBlock Text="Skróty klawiszowe" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Style="{StaticResource AboutBody}" Text="Ctrl+P — ustawienia&#x0a;Esc — wyjście z powiększenia&#x0a;Home — najnowsze zdjęcie&#x0a;← / → — poprzednie / następne zdjęcie&#x0a;Ctrl+M — minimalizacja obu widoków&#x0a;F11 — pełny ekran / tryb okienkowy&#x0a;Dwuklik — widok 100% / dopasowanie"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource SectionCard}"><StackPanel>
                        <TextBlock Text="Jak działa udostępnianie" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Pierwszy QR łączy telefon z hotspotem, drugi pobiera dokładnie zdjęcie widoczne w podglądzie. Po pięciu minutach bez pobierania aplikacja zmienia hasło sesji. Liczba równoległych pobrań jest ograniczona, a pliki wysyłane są w oryginalnej jakości." Style="{StaticResource AboutBody}"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource SectionCard}"><TextBlock><Hyperlink NavigateUri="https://github.com/BlackSingularities/fotopodglad" RequestNavigate="OnRepoLinkRequestNavigate"><Run Text="github.com/BlackSingularities/fotopodglad"/></Hyperlink></TextBlock></Border>
                </StackPanel></ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Button Content="Przywróć domyślne" Click="OnResetDefaultsClick" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Anuluj" Click="OnCancelClick" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                <Button Content="Zapisz" Click="OnSaveClick"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
