<Window x:Class="Fotopodglad.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fotopodgląd — ustawienia"
        Width="480" Height="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource Brush.Background}"
        Foreground="{StaticResource Brush.TextPrimary}"
        FontFamily="{StaticResource Font.Primary}">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Background" Value="#1C1C20"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="#3A3A40"/>
            <Setter Property="CaretBrush" Value="{StaticResource Brush.TextPrimary}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Background" Value="{StaticResource Brush.Accent}"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2A2A30"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Background" Value="#1C1C20"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="#3A3A40"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="Anuluj" Style="{StaticResource SecondaryButton}" Click="OnCancelClick" Margin="0,0,10,0"/>
            <Button x:Name="SaveButton" Content="Zapisz i uruchom" Click="OnSaveClick"/>
        </StackPanel>

        <TabControl Background="Transparent" BorderThickness="0">
            <TabItem Header="Ustawienia">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,16,0,0">
                    <TextBlock Text="Ekran dla Okna A (podgląd najnowszego zdjęcia)" Margin="0,0,0,4"/>
                    <ComboBox x:Name="MainViewScreenComboBox" Margin="0,0,0,14"/>

                    <TextBlock Text="Ekran dla Okna B (siatka zdjęć)" Margin="0,0,0,4"/>
                    <ComboBox x:Name="GridScreenComboBox" Margin="0,0,0,14"/>

                    <TextBlock Text="Nazwa sieci WiFi dla gości (SSID)" Margin="0,0,0,4"/>
                    <TextBox x:Name="WifiSsidTextBox" Margin="0,0,0,4"/>
                    <TextBlock Text="Puste = losowa nazwa przy każdym starcie" FontSize="11"
                               Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,14"/>

                    <TextBlock Text="Hasło do sieci WiFi dla gości" Margin="0,0,0,4"/>
                    <TextBox x:Name="WifiPasswordTextBox" Margin="0,0,0,4"/>
                    <TextBlock Text="Puste = losowe hasło przy każdym starcie" FontSize="11"
                               Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,14"/>

                    <TextBlock Text="Liczba kolumn siatki zdjęć" Margin="0,0,0,4"/>
                    <TextBox x:Name="GridColumnsTextBox" Margin="0,0,0,14"/>

                    <TextBlock Text="Czas podglądu wybranego zdjęcia przed powrotem do najnowszego (sekundy)" Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <TextBox x:Name="ManualHoldTextBox"/>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="O aplikacji">
                <StackPanel Margin="0,20,0,0">
                    <TextBlock Text="Fotopodgląd" FontSize="22" Margin="0,0,0,4"/>
                    <TextBlock Text="Aplikacja do podglądu zdjęć podczas sesji fotograficznej" FontSize="13"
                               Foreground="{StaticResource Brush.TextSecondary}" Margin="0,0,0,20"/>

                    <TextBlock Text="Autor" FontSize="12" Foreground="{StaticResource Brush.TextSecondary}"/>
                    <TextBlock x:Name="AuthorTextBlock" FontSize="15" Margin="0,2,0,16"/>

                    <TextBlock Text="Repozytorium" FontSize="12" Foreground="{StaticResource Brush.TextSecondary}"/>
                    <TextBlock Margin="0,2,0,0">
                        <Hyperlink x:Name="RepoLink" NavigateUri="https://github.com/BlackSingularities/fotopodglad" RequestNavigate="OnRepoLinkRequestNavigate">
                            <Run Text="github.com/BlackSingularities/fotopodglad"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
