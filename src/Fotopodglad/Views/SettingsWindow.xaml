<Window x:Class="Fotopodglad.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fotopodgląd — ustawienia"
        Width="680" Height="760"
        WindowStartupLocation="CenterScreen"
        ShowActivated="True" Topmost="True"
        ResizeMode="NoResize"
        Background="{StaticResource Brush.Background}"
        Foreground="{StaticResource Brush.TextPrimary}"
        FontFamily="{StaticResource Font.Primary}">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#17171C"/>
        <SolidColorBrush x:Key="ControlBrush" Color="#202027"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#34343D"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="AboutBody" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="LineHeight" Value="20"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{StaticResource ControlBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Brush.TextPrimary}"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{StaticResource ControlBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Background" Value="{StaticResource Brush.Accent}"/>
            <Setter Property="Foreground" Value="#151515"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#292930"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent" BorderBrush="{StaticResource Brush.Accent}"
                                BorderThickness="0,0,0,2" Margin="0,0,6,0">
                            <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="0"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{StaticResource ControlBrush}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3A3020"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#34343D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Background" Value="{StaticResource ControlBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                CornerRadius="7">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="32"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Data="M0,0 L5,5 L10,0 Z"
                                                      Fill="{StaticResource Brush.TextSecondary}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              TextElement.Foreground="{StaticResource Brush.TextPrimary}"
                                              Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                            <Popup Placement="Bottom" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False" PopupAnimation="Slide">
                                <Border Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="7"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                        MaxHeight="240" Margin="0,3,0,0">
                                    <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28,24,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="2,0,2,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="AppNameTextBlock" Text="Fotopodgląd" FontSize="25" FontWeight="SemiBold"/>
                <TextBlock Text="Skonfiguruj ekrany, galerię i udostępnianie zdjęć"
                           Foreground="{StaticResource Brush.TextSecondary}" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
            <Image Grid.Column="1" Width="48" Height="48"
                   Source="/Assets/Icons/Fotopodglad-128.png" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Grid>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="Ustawienia">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,16,8,0">
                    <StackPanel>
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="Ekrany" Style="{StaticResource SectionTitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Okno A — podgląd" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="MainViewScreenComboBox"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Okno B — siatka" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="GridScreenComboBox"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Przy co najmniej dwóch monitorach każde okno musi korzystać z innego ekranu."
                                           Style="{StaticResource HintText}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="Folder zdjęć" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Obserwowany folder" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="WatchedFolderTextBox" VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Wybierz…" Click="OnBrowseFolderClick"
                                            Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"/>
                                </Grid>
                                <TextBlock Text="Nowy folder zostanie użyty po zapisaniu ustawień i ponownym uruchomieniu aplikacji."
                                           Style="{StaticResource HintText}" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="Galeria i podgląd" Style="{StaticResource SectionTitle}"/>
                                <CheckBox x:Name="ShowPhotoParametersCheckBox"
                                          Content="Pokazuj nazwę pliku i parametry zdjęcia na podglądzie"
                                          Foreground="{StaticResource Brush.TextPrimary}"
                                          FontSize="13" FontWeight="SemiBold" Margin="0,0,0,16"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Liczba kolumn siatki" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="GridColumnsTextBox"/>
                                        <TextBlock Text="Zakres: 2–12" Style="{StaticResource HintText}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Czas podglądu zdjęcia" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="ManualHoldTextBox"/>
                                        <TextBlock Text="3–900 sekund, potem powrót do najnowszego" Style="{StaticResource HintText}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="Udostępnianie przez QR" Style="{StaticResource SectionTitle}"/>
                                <CheckBox x:Name="GuestAccessEnabledCheckBox"
                                          Content="Automatycznie uruchamiaj hotspot i udostępnianie QR"
                                          Foreground="{StaticResource Brush.TextPrimary}"
                                          FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <CheckBox x:Name="ShowGuestInstructionsCheckBox"
                                          Content="Pokazuj krótką instrukcję dla gości pod siatką zdjęć"
                                          IsEnabled="{Binding IsChecked, ElementName=GuestAccessEnabledCheckBox}"
                                          Foreground="{StaticResource Brush.TextPrimary}"
                                          FontSize="13" Margin="0,0,0,16"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Nazwa sieci WiFi (SSID)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="WifiSsidTextBox"/>
                                        <TextBlock Text="Puste pole = nazwa losowa" Style="{StaticResource HintText}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Hasło WiFi" Style="{StaticResource FieldLabel}"/>
                                        <PasswordBox x:Name="WifiPasswordBox"/>
                                        <TextBlock Text="Puste pole = hasło losowe" Style="{StaticResource HintText}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="54"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                        <TextBlock Text="Wielkość kodów QR" Style="{StaticResource FieldLabel}"/>
                                        <TextBlock Text="96–320 px" Style="{StaticResource HintText}"/>
                                    </StackPanel>
                                    <Slider x:Name="QrSizeSlider" Grid.Column="1" Minimum="96" Maximum="320"
                                            TickFrequency="16" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                            ValueChanged="OnQrSizeChanged"/>
                                    <Border Grid.Column="2" Background="{StaticResource ControlBrush}" CornerRadius="7"
                                            Padding="8,6" Margin="10,0,0,0">
                                        <TextBlock x:Name="QrSizeValueTextBlock" Text="160" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="O aplikacji">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,16,8,0">
                    <StackPanel>
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock x:Name="AboutAppNameTextBlock" Text="Fotopodgląd" FontSize="24" FontWeight="SemiBold"/>
                                <TextBlock Text="Podgląd i udostępnianie zdjęć podczas sesji fotograficznej"
                                           Foreground="{StaticResource Brush.TextSecondary}" Margin="0,5,0,18"/>
                                <TextBlock Style="{StaticResource AboutBody}"
                                           Text="Aplikacja obserwuje wybrany folder i automatycznie pokazuje nowe zdjęcia. Fotograf może od razu prezentować ujęcia klientowi, wracać do wcześniejszych kadrów i udostępniać wyświetlane zdjęcie telefonem — bez kopiowania plików do dodatkowej biblioteki."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="Szybki start" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="1. Wybierz folder, do którego trafiają zdjęcia z aparatu." Style="{StaticResource AboutBody}"/>
                                <TextBlock Text="2. Ustaw ekran podglądu i ekran siatki. Przy jednym monitorze aplikacja sama dzieli ekran w proporcji 60/40."
                                           Style="{StaticResource AboutBody}" Margin="0,8,0,0"/>
                                <TextBlock Text="3. Zapisz ustawienia. Nowe pliki JPG będą pojawiały się automatycznie, bez ręcznego odświeżania."
                                           Style="{StaticResource AboutBody}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="Widoki i sterowanie" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Podgląd" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="Pokazuje najnowsze zdjęcie, jego nazwę i dostępne parametry EXIF. Kółko myszy przybliża i oddala fotografię. Panel parametrów można ukryć w ustawieniach."
                                           Style="{StaticResource AboutBody}" Margin="0,0,0,14"/>
                                <TextBlock Text="Siatka zdjęć" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="Zawiera wszystkie zdjęcia z sesji w równych kafelkach. Siatkę przewija się pionowo. Kliknięcie miniatury pokazuje wybrane zdjęcie w głównym podglądzie przez ustawiony czas."
                                           Style="{StaticResource AboutBody}" Margin="0,0,0,14"/>
                                <TextBlock Text="Ustawienia" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Style="{StaticResource AboutBody}">
                                    <Run Text="Naciśnij "/><Run Text="Ctrl+P" FontWeight="Bold" Foreground="{StaticResource Brush.TextPrimary}"/><Run Text=", aby w dowolnym momencie zmienić folder, ekrany, siatkę, czas podglądu, parametry zdjęcia, hotspot lub wielkość QR."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="Hotspot i kody QR" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Po włączeniu tej funkcji pierwszy kod QR łączy telefon z siecią WiFi utworzoną przez komputer. Drugi kod pobiera dokładnie zdjęcie aktualnie widoczne w podglądzie."
                                           Style="{StaticResource AboutBody}"/>
                                <TextBlock Text="Panel QR ma własne miejsce obok siatki i nie zasłania zdjęć. Po 5 minutach bez pobrania aplikacja rozłącza gości, ustawia nowe hasło i odświeża kod WiFi. Hotspot pozostaje dostępny aż do zamknięcia aplikacji."
                                           Style="{StaticResource AboutBody}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="Prywatność i pliki" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Fotopodgląd nie tworzy kopii zdjęć. Miniatury istnieją tylko w pamięci RAM, a pobieranie przez QR wysyła oryginalny plik bezpośrednio z wybranego folderu. Na dysku zapisywany jest wyłącznie plik ustawień aplikacji."
                                           Style="{StaticResource AboutBody}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock>
                                    <Hyperlink x:Name="RepoLink" NavigateUri="https://github.com/BlackSingularities/fotopodglad"
                                               RequestNavigate="OnRepoLinkRequestNavigate">
                                        <Run Text="github.com/BlackSingularities/fotopodglad"/>
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <TextBlock Text="Zmiany zostaną zastosowane po uruchomieniu widoków."
                       Style="{StaticResource HintText}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Anuluj" Style="{StaticResource SecondaryButton}"
                        Click="OnCancelClick" Margin="0,0,10,0"/>
                <Button x:Name="SaveButton" Content="Zapisz i uruchom" Click="OnSaveClick"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
