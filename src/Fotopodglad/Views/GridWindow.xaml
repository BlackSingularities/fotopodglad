<Window x:Class="Fotopodglad.Views.GridWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fotopodgląd — siatka"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        KeyDown="OnKeyDown"
        Background="{StaticResource Brush.Background}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <!-- Auto rezerwuje dokładnie tyle miejsca, ile potrzebuje aktywny panel QR.
                 Gdy panel jest ukryty, kolumna zwija się do zera. -->
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid x:Name="GridHost" Grid.Column="0"/>

        <TextBlock Grid.Column="0" Text="Oczekiwanie na zdjęcia…"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="24" Foreground="{StaticResource Brush.TextSecondary}"
                   IsHitTestVisible="False">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Photos.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Grid x:Name="GuestSidebarHost" Grid.Column="1"
              HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
    </Grid>
</Window>
