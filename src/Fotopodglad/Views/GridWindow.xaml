<Window x:Class="Fotopodglad.Views.GridWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Fotopodglad.Models"
        Title="Fotopodgląd — siatka"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        KeyDown="OnKeyDown"
        Background="{StaticResource Brush.Background}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <!-- Auto rezerwuje dokładnie tyle miejsca, ile potrzebuje aktywny panel QR.
                 Gdy panel jest ukryty, kolumna zwija się do zera. -->
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid x:Name="GridHost" Grid.Row="0" Grid.Column="0"/>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Oczekiwanie na zdjęcia…"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="24" Foreground="{StaticResource Brush.TextSecondary}"
                   IsHitTestVisible="False">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Photos.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Border x:Name="GuestInstructionBorder" Grid.Row="1" Grid.Column="0"
                Margin="20,8,20,14" Padding="14,9"
                Background="{StaticResource Brush.SurfaceOverlay}" CornerRadius="8"
                Opacity="0.82" IsHitTestVisible="False">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:GuestAccessStatus.Active}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       FontSize="11" Foreground="{StaticResource Brush.TextSecondary}">
                <Run Text="1. Zeskanuj „Dołącz do sieci”" FontWeight="SemiBold"/>
                <Run Text="  •  2. Kliknij zdjęcie, które chcesz pobrać"/>
                <Run Text="  •  3. Zeskanuj „Pobierz wyświetlane zdjęcie” — możesz zapisać je na telefonie"/>
            </TextBlock>
        </Border>

        <Grid x:Name="GuestSidebarHost" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
              HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
    </Grid>
</Window>
