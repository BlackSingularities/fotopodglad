<UserControl x:Class="Fotopodglad.Controls.GuestAccessSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             IsHitTestVisible="False">
    <!--
        Pasywny panel bez żadnych kontrolek (nic tu nie da się kliknąć — IsHitTestVisible=False):
        dwa kody QR, które gość skanuje aparatem telefonu. Nazwa sieci/hasło nigdy nie są pokazywane
        tekstem, wyłącznie zakodowane w QR "dołącz do WiFi". Widoczny tylko, gdy hotspot faktycznie działa.
    -->
    <Border x:Name="RootBorder" Margin="8,0,8,12" Padding="8"
            Background="{DynamicResource Brush.SurfaceOverlay}" CornerRadius="8"
            Visibility="Collapsed">
        <StackPanel x:Name="QrGroupsPanel">
            <StackPanel>
                <TextBlock Text="Dołącz do sieci" Style="{StaticResource Style.ExifText}" FontSize="12"
                           Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                <Image x:Name="WifiQrImage" Width="120" Height="120" RenderOptions.BitmapScalingMode="HighQuality"/>
            </StackPanel>

            <StackPanel x:Name="PhotoQrGroup" Margin="0,10,0,0">
                <TextBlock Text="Pobierz wyświetlane zdjęcie" Style="{StaticResource Style.ExifText}" FontSize="12"
                           Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                <Image x:Name="PhotoQrImage" Width="120" Height="120" RenderOptions.BitmapScalingMode="HighQuality"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
